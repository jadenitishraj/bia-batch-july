# OpenAI — required for live model calls
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# LangSmith — optional, enables tracing in the LangSmith UI
# Create a LangSmith account and API key, then set tracing to true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT=BIA_Prompt_Essentials

# Legacy LangChain variable names — only use if your local setup still expects them.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_your-langsmith-key-here
# LANGCHAIN_PROJECT=BIA_Prompt_Essentials
