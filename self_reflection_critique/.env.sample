# OpenAI — required for live LLM calls
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Demo fallback — optional
# Set to true if the classroom has no network/API key and you want deterministic simulated outputs.
BIA_OFFLINE_DEMO=false

# LangSmith — optional tracing if already configured from the Prompt Essentials session
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=BIA_Self_Reflection_Critique

# AutoGen preview — optional, same OpenAI key/model are reused
AUTOGEN_MODEL=gpt-4o-mini
