# Copy to .env. Run backend from this app's root.
DATABASE_PATH=.local/support.sqlite3
GOOGLE_CLIENT_FILE=.local/google-client.json
GOOGLE_TOKEN_FILE=.local/google-token.json
# In Gmail, manually apply this dedicated label only to synthetic classroom mail.
GMAIL_QUERY=label:BIA-Support
# Prefer a dedicated classroom calendar; primary works for a synthetic demo.
GOOGLE_CALENDAR_ID=primary
GOOGLE_POLL_SECONDS=30

# Gemini is separate from Gmail/Calendar OAuth. Never use VITE_ for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: explicitly reuse ONLY the Gemini key/model from an authorized local .env.
# GEMINI_ENV_FILE=../github-issue-agent/.env
APP_TIMEZONE=Asia/Kolkata

# Optional proposal/approval authorization, separate from read-only polling.
GOOGLE_AUTOMATION_TOKEN_FILE=.local/google-automation-token.json
# Always checks primary and each job's target calendar, plus these optional busy calendars.
GOOGLE_BUSY_CALENDAR_IDS=
# Monitoring and per-proposal approvals are stored in SQLite; no env toggle bypasses approval.
