# Gemini is the model. A Helicone key enables its Gemini proxy; otherwise call Google directly.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
HELICONE_API_KEY=
# LangSmith: automatic nested spans, with one @traceable above each agent-step function.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bia-july-travel-planner-demo
LANGSMITH_TRACING=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_HIDE_METADATA=true
# Grafana Cloud: stack endpoints and a logs:write + metrics:write token.
GRAFANA_CLOUD_TOKEN=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
# The separate document indexing/embedding pipeline keeps its existing OpenAI integration.
OPENAI_API_KEY=
