OPENAI_API_KEY=
CHAT_PROVIDER=openai
# For Gemini, set CHAT_PROVIDER=gemini and privately add your existing API key.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional hosted gateway: CHAT_PROVIDER=helicone. Add only its key here.
# HELICONE_API_KEY=
HELICONE_MODEL=gemini-3.1-flash-lite/google-ai-studio
# Optional synthetic tracing demo only; ordinary trip requests stay untraced.
# TRAVEL_PLANNER_LANGSMITH_API_KEY=
TRAVEL_PLANNER_LANGSMITH_PROJECT=bia-july-travel-planner-demo
# Optional Grafana Cloud telemetry (stack endpoints and a write-only token).
# GRAFANA_CLOUD_TOKEN=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
