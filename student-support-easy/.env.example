# Copy this file to .env. Keep real values private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Reuse the separately consented token from the original classroom app.
# Or point this to your own authorized-user token file.
EASY_GOOGLE_TOKEN=../live-student-support-dashboard/.local/google-automation-token.json
EASY_DATABASE=.local/easy.sqlite3
# Optional explicit environment file for Gemini fields only:
# GEMINI_ENV_FILE=/path/to/your/authorized/.env
